# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública del proyecto Supabase (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base de la app (usada por Supabase Auth para los enlaces de confirmación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
